# deploy/<target>.env — per-target deploy settings that must not be committed.
#
# Copy to deploy/<target>.env (e.g. deploy/vision-dev.env; *.env here is gitignored) and fill in.
# scripts/deploy.sh <target> sources it automatically. A profile passed on the command line
# overrides DATABRICKS_CONFIG_PROFILE.
#
# Any bundle variable can be set as BUNDLE_VAR_<name>; these are the ones without defaults.
# Find the values as described in DEPLOY.md (section 2a for Lakebase). Keep the quotes:
# this file is sourced by bash.

DATABRICKS_CONFIG_PROFILE="<your-cli-profile>"

BUNDLE_VAR_catalog="<your-catalog>"
BUNDLE_VAR_schema_name="<your-schema>"
BUNDLE_VAR_lakebase_endpoint="projects/<project>/branches/<branch>/endpoints/<endpoint>"
BUNDLE_VAR_lakebase_branch="projects/<project>/branches/<branch>"
BUNDLE_VAR_lakebase_database="projects/<project>/branches/<branch>/databases/<db-id>"
BUNDLE_VAR_lakebase_db_host="ep-<slug>.database.<region>.cloud.databricks.com"
